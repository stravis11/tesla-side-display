{
  "schemaVersion": 1,
  "id": "st87.side-display",
  "name": "Tesla Side Display",
  "version": "0.2.0",
  "author": "st87",
  "license": "MIT",
  "description": "Extend Hyprland into up to three browser displays with WebRTC video and touch control.",
  "kinds": ["bar-widget"],
  "entryPoints": {"barWidget": "Panel.qml"},
  "barWidget": {
    "displayName": "Tesla Side Display",
    "description": "Start browser displays, copy pairing links, and disconnect devices.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {"host": "0.0.0.0", "port": 8876, "fps": 30, "maxDisplays": 3},
    "schema": [
      {"key": "host", "type": "string", "label": "Listen address", "defaultValue": "0.0.0.0"},
      {"key": "port", "type": "integer", "label": "Connection port", "min": 1024, "max": 65535, "defaultValue": 8876},
      {"key": "maxDisplays", "type": "integer", "label": "Maximum displays", "min": 1, "max": 3, "defaultValue": 3}
    ]
  }
}
